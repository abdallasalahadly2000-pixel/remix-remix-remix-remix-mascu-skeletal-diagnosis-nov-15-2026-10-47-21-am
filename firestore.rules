rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && request.auth.token.email == 'moaaz.amr.bakeer@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isEmailVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isVerifiedDoctor() {
      return isAdmin() || (
        isEmailVerified() && (
          exists(/databases/$(database)/documents/doctors/$(request.auth.uid)) ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor'
          )
        )
      );
    }

    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBadgeId(badge) {
      return badge is string &&
        badge.size() >= 1 &&
        badge.size() <= 40 &&
        badge.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRole(role) {
      return role is string && role in ['astronaut', 'doctor'];
    }

    function isValidSpecialty(specialty) {
      return specialty is string && specialty in [
        'Mission Commander',
        'Flight Engineer',
        'Payload Specialist',
        'Flight Surgeon',
        'Orthopedic Specialist'
      ];
    }

    function isValidDoctorSpecialty(specialty) {
      return specialty is string && specialty in [
        'Flight Surgeon',
        'Orthopedic Specialist'
      ];
    }

    function isValidPrediction(prediction) {
      return prediction is string && prediction in [
        'Normal',
        'Osteopenia',
        'Osteoporosis'
      ];
    }

    function isValidSeverity(severity) {
      return severity is string && severity in [
        'L1',
        'L2',
        'L3',
        'L4'
      ];
    }

    function isValidApprovalStatus(status) {
      return status is string && status in [
        'pending',
        'approved',
        'not_approved'
      ];
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'role', 'fullName', 'badgeId', 'specialty', 'missionName', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'role', 'fullName', 'badgeId', 'specialty', 'missionName', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        isValidRole(data.role) &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
        isValidBadgeId(data.badgeId) &&
        isValidSpecialty(data.specialty) &&
        data.missionName is string && data.missionName.size() >= 1 && data.missionName.size() <= 80 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDoctorAuth(data) {
      return data.keys().hasAll(['uid', 'fullName', 'specialty', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'fullName', 'specialty', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
        isValidDoctorSpecialty(data.specialty) &&
        isValidId(data.grantedBy) &&
        data.createdAt is timestamp;
    }

    function isValidTreatmentPlan(data) {
      return data.keys().hasAll([
          'planCode', 'ownerId', 'assignedDoctorUid', 'astronautName', 'astronautBadge',
          'mode', 'sos', 'bua', 'unloadingMonths', 'prediction', 'confidence', 'tScore',
          'bhi', 'bdsPercent', 'ebmd', 'clinicalTier', 'recommendation',
          'selectedBoneIds', 'severityLevel', 'approvalStatus', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'planCode', 'ownerId', 'assignedDoctorUid', 'astronautName', 'astronautBadge',
          'mode', 'sos', 'bua', 'unloadingMonths', 'prediction', 'confidence', 'tScore',
          'bhi', 'bdsPercent', 'ebmd', 'clinicalTier', 'recommendation',
          'selectedBoneIds', 'severityLevel', 'approvalStatus',
          'reviewedByUid', 'reviewedByName', 'createdAt', 'updatedAt'
        ]) &&
        data.planCode is string && data.planCode.size() >= 3 && data.planCode.size() <= 32 &&
        data.planCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidId(data.ownerId) &&
        isValidId(data.assignedDoctorUid) &&
        data.astronautName is string && data.astronautName.size() >= 1 && data.astronautName.size() <= 100 &&
        isValidBadgeId(data.astronautBadge) &&
        data.mode is string && data.mode in ['dual', 'full'] &&
        data.sos is number && data.sos >= 1200 && data.sos <= 2600 &&
        data.bua is number && data.bua >= 10 && data.bua <= 140 &&
        data.unloadingMonths is number && data.unloadingMonths >= 0 && data.unloadingMonths <= 120 &&
        isValidPrediction(data.prediction) &&
        data.confidence is number && data.confidence >= 0 && data.confidence <= 100 &&
        data.tScore is number && data.tScore >= -10 && data.tScore <= 10 &&
        data.bhi is number && data.bhi >= 0 && data.bhi <= 100 &&
        data.bdsPercent is number && data.bdsPercent >= 0 && data.bdsPercent <= 100 &&
        data.ebmd is number && data.ebmd >= 0 && data.ebmd <= 5 &&
        data.clinicalTier is string && data.clinicalTier.size() >= 3 && data.clinicalTier.size() <= 100 &&
        data.recommendation is string && data.recommendation.size() >= 1 && data.recommendation.size() <= 2000 &&
        data.selectedBoneIds is list &&
        data.selectedBoneIds.size() >= 1 && data.selectedBoneIds.size() <= 15 &&
        data.selectedBoneIds[0] is string &&
        isValidSeverity(data.severityLevel) &&
        isValidApprovalStatus(data.approvalStatus) &&
        (!('reviewedByUid' in data) || isValidId(data.reviewedByUid)) &&
        (!('reviewedByName' in data) || (data.reviewedByName is string && data.reviewedByName.size() >= 1 && data.reviewedByName.size() <= 100)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTreatmentFeedback(data) {
      return data.keys().hasAll([
          'planId', 'planCode', 'patientUid', 'patientName',
          'doctorUid', 'doctorName', 'decision', 'negativePoints', 'improvements', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'planId', 'planCode', 'patientUid', 'patientName',
          'doctorUid', 'doctorName', 'decision', 'negativePoints', 'improvements', 'createdAt'
        ]) &&
        isValidId(data.planId) &&
        data.planCode is string && data.planCode.size() >= 3 && data.planCode.size() <= 32 &&
        data.planCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidId(data.patientUid) &&
        data.patientName is string && data.patientName.size() >= 1 && data.patientName.size() <= 100 &&
        isValidId(data.doctorUid) &&
        data.doctorName is string && data.doctorName.size() >= 1 && data.doctorName.size() <= 100 &&
        data.decision is string && data.decision in ['approved', 'not_approved'] &&
        data.negativePoints is string && data.negativePoints.size() <= 2000 &&
        data.improvements is string && data.improvements.size() <= 2000 &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isEmailVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().role in ['astronaut', 'doctor'];
      allow update: if isEmailVerified() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        (isOwner(userId) || isAdmin()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'role', 'fullName', 'badgeId', 'specialty', 'missionName', 'updatedAt'
            ])
          ) ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'badgeId', 'specialty', 'missionName', 'updatedAt'
            ])
          ) ||
          (
            isOwner(userId) &&
            isVerifiedDoctor() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'role', 'fullName', 'badgeId', 'specialty', 'missionName', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      match /private/{docId} {
        allow get: if isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          (isOwner(userId) || isAdmin());
        allow list: if isBootstrappedAdmin();
        allow create: if isEmailVerified() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isEmailVerified() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    match /doctors/{doctorUid} {
      allow get: if isValidId(doctorUid) && (isOwner(doctorUid) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin() &&
        isValidId(doctorUid) &&
        isValidDoctorAuth(incoming()) &&
        incoming().uid == doctorUid &&
        incoming().grantedBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isAdmin() &&
        isValidId(doctorUid) &&
        isValidDoctorAuth(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().grantedBy == existing().grantedBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'specialty']);
      allow delete: if isAdmin() && isValidId(doctorUid);
    }

    match /treatmentPlans/{planId} {
      allow get: if isValidId(planId) &&
        isSignedIn() &&
        (
          existing().ownerId == request.auth.uid ||
          existing().assignedDoctorUid == request.auth.uid ||
          isVerifiedDoctor()
        );
      allow list: if isSignedIn() && (
        existing().ownerId == request.auth.uid ||
        existing().assignedDoctorUid == request.auth.uid ||
        existing().assignedDoctorUid == 'unassigned' ||
        isBootstrappedAdmin()
      );
      allow create: if isEmailVerified() &&
        isValidId(planId) &&
        isValidTreatmentPlan(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().approvalStatus == 'pending' &&
        !('reviewedByUid' in incoming()) &&
        !('reviewedByName' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isEmailVerified() &&
        isValidId(planId) &&
        isValidTreatmentPlan(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().reviewedByUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'approvalStatus', 'reviewedByUid', 'reviewedByName', 'updatedAt'
            ])
          ) ||
          (
            isVerifiedDoctor() &&
            existing().approvalStatus == 'pending' &&
            incoming().approvalStatus in ['approved', 'not_approved'] &&
            incoming().reviewedByUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'approvalStatus', 'reviewedByUid', 'reviewedByName', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(planId) && isAdmin();
    }

    match /treatmentFeedback/{feedbackId} {
      allow get: if isValidId(feedbackId) &&
        isSignedIn() &&
        (
          existing().patientUid == request.auth.uid ||
          existing().doctorUid == request.auth.uid ||
          isVerifiedDoctor()
        );
      allow list: if isSignedIn() && (
        existing().patientUid == request.auth.uid ||
        existing().doctorUid == request.auth.uid ||
        isBootstrappedAdmin()
      );
      allow create: if isEmailVerified() &&
        isValidId(feedbackId) &&
        isValidTreatmentFeedback(incoming()) &&
        isVerifiedDoctor() &&
        incoming().doctorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/treatmentPlans/$(incoming().planId)) &&
        get(/databases/$(database)/documents/treatmentPlans/$(incoming().planId)).data.ownerId == incoming().patientUid &&
        getAfter(/databases/$(database)/documents/treatmentPlans/$(incoming().planId)).data.approvalStatus == incoming().decision &&
        getAfter(/databases/$(database)/documents/treatmentPlans/$(incoming().planId)).data.reviewedByUid == request.auth.uid;
      allow update: if isValidId(feedbackId) &&
        isAdmin() &&
        isValidTreatmentFeedback(incoming()) &&
        incoming().planId == existing().planId &&
        incoming().patientUid == existing().patientUid &&
        incoming().doctorUid == existing().doctorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'decision', 'negativePoints', 'improvements'
        ]);
      allow delete: if isValidId(feedbackId) && isAdmin();
    }
  }
}
